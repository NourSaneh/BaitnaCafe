---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Start of today, so an event ending today stays visible all day
const today = new Date();
today.setHours(0, 0, 0, 0);

const events = (await getCollection('events'))
  .filter(({ data }) => !data.endDate || data.endDate >= today) // hide finished events
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section id="events" class="bg-[#EDE6DD] py-20 md:py-28" aria-labelledby="events-title">
  <div class="mx-auto w-full max-w-[1760px] px-5 md:px-10 xl:px-20">
    <!-- Heading -->
    <div class="text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-neutral-700 md:text-sm">What's happening</p>
      <h2
        id="events-title"
        class="font-display mt-3 text-5xl tracking-[0.15em] text-neutral-900 md:text-7xl xl:text-8xl"
      >
        AT BAITNA
      </h2>
      <p class="mt-3 text-sm uppercase tracking-[0.25em] text-neutral-700">The best rooftop café</p>
    </div>

    <!-- Cards -->
    <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 xl:gap-12">
      {events.map(({ data }) => (
        <article class="flex flex-col">
          <Image
            src={data.image}
            alt={data.title}
            widths={[480, 720, 1000]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-[4/5] w-full object-cover"
          />

          <p class="mt-5 text-xs uppercase tracking-[0.2em] text-[#7a5c34] md:text-sm">{data.dateLabel}</p>
          <h3 class="mt-2 text-xl tracking-wide text-neutral-900 md:text-2xl">{data.title}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-neutral-700">{data.description}</p>

          {data.bookingUrl && (
            <a
              href={data.bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex min-h-12 items-center self-start border border-[#7a5c34] px-8 text-sm uppercase tracking-[0.2em] text-[#7a5c34]
                     transition-colors hover:bg-[#7a5c34] hover:text-cream
                     focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7a5c34]"
            >
              Book now
            </a>
          )}
        </article>
      ))}
    </div>

    {events.length === 0 && (
      <p class="mt-14 text-center text-neutral-600">New events coming soon — stay tuned!</p>
    )}
  </div>
</section>