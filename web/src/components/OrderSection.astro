---
// src/components/OrderSection.astro
import { Image } from 'astro:assets';
import barImage from '../assets/bar.png';
import drivuLogo from '../assets/drivu-logo.png';
import beanzLogo from '../assets/beanz-logo.png';
import noonLogo from '../assets/noon-logo.png';

const partners = [
  { name: 'Drivu', logo: drivuLogo, label: 'Drivethru', href: 'https://drivu.com' },
  { name: 'Beanz', logo: beanzLogo, label: 'Delivery', href: '#' },
  { name: 'noon',  logo: noonLogo,  label: 'Delivery', href: '#' },
];
---

<section
  class="mx-auto grid max-w-[1100px] gap-1.5 p-4 text-black"
  aria-labelledby="order-title"
>
  <!-- Top block -->
  <div class="grid min-h-[300px] grid-cols-1 bg-[#d9d9d9] md:grid-cols-2">
    <div class="flex flex-col justify-center p-8 tracking-[0.08em]">
      <p class="mb-7 text-[0.95rem]">Baitna Café</p>
      <h2 id="order-title" class="mb-6 text-2xl font-normal md:text-[1.75rem]">
        Drive thru or delivery
      </h2>
      <p class="max-w-[36ch] text-[0.95rem] leading-snug">
        Order on your favourite app. We'll have it ready.
      </p>
    </div>

    <div class="order-first aspect-[4/3] md:order-none md:aspect-auto">
      <Image
        src={barImage}
        alt="Baitna Café coffee bar with a vintage car parked inside"
        class="block h-full w-full object-cover"
      />
    </div>
  </div>

  <!-- Partners row -->
  <ul
    class="grid list-none grid-cols-1 divide-y divide-[#333] bg-[#d9d9d9]
           md:grid-cols-3 md:divide-x md:divide-y-0 md:pt-3 md:pb-6"
  >
    {partners.map((p) => (
      <li class="flex flex-col items-center px-4 py-6 md:px-5 md:py-0">
        <div class="flex h-20 items-center justify-center">
          <Image src={p.logo} alt={p.name} class="max-h-full max-w-full object-contain" />
        </div>

        <p class="mt-5 mb-6 tracking-[0.1em]">{p.label}</p>

        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-w-[100px] items-center justify-center rounded-full
                 bg-[#bb9965] px-6 py-2.5 text-sm text-white no-underline
                 transition hover:brightness-90 motion-reduce:transition-none
                 focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-black"
        >
          Order on {p.name}
        </a>
      </li>
    ))}
  </ul>
</section>
