---
import { Image } from 'astro:assets';
import herobg from '../assets/herobg.jpg';
import cloudMatcha from '../assets/cloud-Matcha.png';
import chocolateDrink from '../assets/chocolatedrink.png';
import sandwich from '../assets/sandwich.png';
import Nav from './nav.astro';

const reserveUrl =
  'https://ae.dyneapp.io/reservations/285829b0-5e4b-11f0-a785-c55a8f5bd3a2';

// Add more drinks here — the arrows will cycle through all of them
const drinks = [
  { src: cloudMatcha, alt: 'Iced cloud matcha' },
  { src: chocolateDrink, alt: 'Iced chocolate' },
  { src: sandwich, alt: 'Grilled halloumi sandwich' },
];
---

<header class="relative h-[90svh] min-h-[600px]">
  <!-- Background photo -->
  <Image
    src={herobg}
    alt="Baitna Cafe interior overlooking Sharjah"
    width={1920}
    quality={90}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <!-- Light overall tint + darker fade at the bottom so the text stays readable -->
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="absolute inset-x-0 bottom-0 h-3/4 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>

  <Nav />

  <!-- Hero text -->
<!-- Hero text -->
<div class="absolute inset-x-0 bottom-28 z-10 md:bottom-[180px] xl:bottom-14">
  <div class="mx-auto w-full max-w-[1920px] px-5 md:px-10 xl:px-12">
    <div class="max-w-[760px]">
      <h1 class="text-4xl leading-[1.1] tracking-[0.04em] text-cream md:text-6xl xl:text-7xl 2xl:text-[5.25rem]">
        Your home above Sharjah
      </h1>

      <p class="mt-4 text-base tracking-[0.08em] text-cream/90 md:text-lg xl:mt-5 xl:text-xl">
        Rooftop café · 30th floor · Open daily 8 am – 2 am
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 xl:mt-10">
        <a
          href={reserveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center bg-cream px-8 text-sm uppercase tracking-[0.2em] text-[#3b2a1f]
                 transition hover:bg-white
                 md:min-h-14 md:px-10 md:text-base xl:min-h-16 xl:px-12
                 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cream"
        >
          Reserve a table
        </a>

        <a
          href="#order-section"
          class="inline-flex min-h-12 items-center text-sm uppercase tracking-[0.2em] text-cream
                 underline decoration-cream/50 underline-offset-8 transition hover:decoration-cream
                 md:min-h-14 md:text-base xl:min-h-16
                 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cream"
        >
          Order delivery
        </a>
      </div>
    </div>
  </div>
</div>

  <!-- Circle with the drink slider (swipeable) -->
<div
  id="drink-circle"
  class="absolute bottom-0 left-1/2 z-20 flex h-64 w-64 -translate-x-1/2 translate-y-2/3 touch-pan-y select-none items-center justify-center rounded-full bg-[#E8D5BF]
         ring-[10px] ring-[#F5EEE6] md:h-[420px] md:w-[420px] md:ring-[16px]"
>
    <!-- Drinks (stacked on top of each other, only one visible) — gently floats -->
    <div class="float relative aspect-square w-[75%]">
      {drinks.map((drink, i) => (
        <Image
          src={drink.src}
          alt={drink.alt}
          width={800}
          loading="eager"
          draggable="false"
          data-drink
          class:list={[
            'absolute inset-0 h-full w-full object-contain drop-shadow-xl',
            i === 0 ? 'opacity-100' : 'opacity-0',
          ]}
        />
      ))}
    </div>

    <!-- Dots (show which drink you're on) -->
    <div class="absolute bottom-[6%] left-1/2 flex -translate-x-1/2 gap-2">
      {drinks.map((_, i) => (
        <span
          data-dot
          class:list={[
            'h-2 rounded-full transition-all duration-300',
            i === 0 ? 'w-5 bg-[#5C4033]' : 'w-2 bg-[#5C4033]/30',
          ]}
        ></span>
      ))}
    </div>

    <!-- Arrow ring (rotates around the circle on click) -->
    <div id="arrow-ring" class="pointer-events-none absolute inset-0">
      <!-- Sway layer (gentle idle rocking) -->
      <div class="sway absolute inset-0">
        <!-- Next arrow -->
        <button
          id="drink-next"
          type="button"
          aria-label="Next drink"
          class="pointer-events-auto absolute right-[4%] top-[12%] rounded-full bg-[#5C4033]/85 p-2 text-white shadow-lg ring-2 ring-white/40 transition hover:scale-110 hover:bg-[#5C4033] md:p-3"
        >
          <svg class="h-8 w-8 md:h-10 md:w-10" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M6 4 A14 14 0 0 1 20 18" />
            <path d="M20 18 L17 14.5 M20 18 L23 14.5" />
          </svg>
        </button>

        <!-- Previous arrow -->
        <button
          id="drink-prev"
          type="button"
          aria-label="Previous drink"
          class="pointer-events-auto absolute bottom-[12%] left-[4%] rounded-full bg-[#5C4033]/85 p-2 text-white shadow-lg ring-2 ring-white/40 transition hover:scale-110 hover:bg-[#5C4033] md:p-3"
        >
          <svg class="h-8 w-8 rotate-180 md:h-10 md:w-10" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M6 4 A14 14 0 0 1 20 18" />
            <path d="M20 18 L17 14.5 M20 18 L23 14.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const drinks = document.querySelectorAll<HTMLElement>('[data-drink]');
  const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
  const circle = document.getElementById('drink-circle');
  const ring = document.getElementById('arrow-ring');
  const nextBtn = document.getElementById('drink-next');
  const prevBtn = document.getElementById('drink-prev');

  let current = 0;
  let animating = false;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const speed = reduceMotion ? 0 : 1;

  // Arrows travel half a turn around the circle
  function orbit(dir: 1 | -1) {
    ring?.animate(
      [
        { transform: 'rotate(0deg)' },
        { transform: `rotate(${180 * dir}deg)` },
      ],
      { duration: 750 * speed, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' }
      // no "fill" → it snaps back to 0° at the end, which looks identical
    );
  }

  // Highlight the dot for the current drink
  function updateDots() {
    dots.forEach((dot, i) => {
      const active = i === current;
      dot.classList.toggle('w-5', active);
      dot.classList.toggle('w-2', !active);
      dot.classList.toggle('bg-[#5C4033]', active);
      dot.classList.toggle('bg-[#5C4033]/30', !active);
    });
  }

  function show(dir: 1 | -1) {
    if (animating) return;
    animating = true;

    const outgoing = drinks[current];
    current = (current + dir + drinks.length) % drinks.length;
    const incoming = drinks[current];

    outgoing.animate(
      [
        { opacity: 1, transform: 'rotate(0deg) scale(1)' },
        { opacity: 0, transform: `rotate(${50 * dir}deg) scale(0.6)` },
      ],
      { duration: 450 * speed, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
    );

    const enter = incoming.animate(
      [
        { opacity: 0, transform: `rotate(${-50 * dir}deg) scale(0.6)` },
        { opacity: 1, transform: 'rotate(0deg) scale(1)' },
      ],
      { duration: 600 * speed, delay: 150 * speed, easing: 'cubic-bezier(0.2, 0.9, 0.3, 1.2)', fill: 'forwards' }
    );

    enter.onfinish = () => (animating = false);

    updateDots();
  }

  // One function for arrows and swipes
  function go(dir: 1 | -1) {
    if (animating) return;
    orbit(dir);
    show(dir);
  }

  nextBtn?.addEventListener('click', () => go(1));
  prevBtn?.addEventListener('click', () => go(-1));

  // Swipe left/right on the circle (works with touch and mouse)
  let startX = 0;

  circle?.addEventListener('pointerdown', (e) => {
    startX = e.clientX;
  });

  circle?.addEventListener('pointerup', (e) => {
    const distance = e.clientX - startX;
    if (Math.abs(distance) < 40) return; // ignore taps and tiny moves
    go(distance < 0 ? 1 : -1); // swipe left = next, swipe right = previous
  });
</script>

<style>
  /* Only animate for people who haven't turned off motion in their settings */
  @media (prefers-reduced-motion: no-preference) {
    .sway {
      animation: sway 5s ease-in-out infinite;
    }

    .float {
      animation: float 4s ease-in-out infinite;
    }
  }

  /* Arrows rock gently around the circle */
  @keyframes sway {
    0%, 100% { transform: rotate(-8deg); }
    50%      { transform: rotate(8deg); }
  }

  /* Drink bobs up and down */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }
</style>