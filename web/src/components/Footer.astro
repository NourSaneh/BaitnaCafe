---
const year = new Date().getFullYear();

const address = 'Baitna Café, Tabark Tower, Al Mamzar, Sharjah';

// Google Maps embed (Share → Embed a map) for the Baitna Cafe listing
const mapEmbedSrc =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3606.7102224355845!2d55.361372100000004!3d25.313938200000003!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e5f5b00290fbb4f%3A0x7cd19776f28f6498!2zQmFpdG5hIENhZmUgLSDYqNmK2KrZhtinINmD2KfZgdmK2Yc!5e0!3m2!1sen!2sae!4v1791294921381!5m2!1sen!2sae';

// Opens the café's Google Maps listing
const mapLink =
  'https://www.google.com/maps/place/Baitna+Cafe/@25.3139382,55.3613721,17z/data=!4m6!3m5!1s0x3e5f5b00290fbb4f:0x7cd19776f28f6498!8m2!3d25.3139382!4d55.3613721';

const reserveUrl =
  'https://ae.dyneapp.io/reservations/285829b0-5e4b-11f0-a785-c55a8f5bd3a2?utm_source=website&utm_medium=referral&utm_content=footer';

const phone = '+971 56 546 3774';      // shown on the page
const phoneHref = 'tel:+971565463774'; // used by the link (no 0 after +971)
const whatsapp = '971565463774';

const hours = [
  { days: 'Monday–Sunday', time: '8 am – 2 am' },
];

const pages = [
  { label: 'Home', href: '/' },
  { label: 'Menu', href: 'https://ae.dyneapp.io/menu/sopd/285829b0-5e4b-11f0-a785-c55a8f5bd3a2/rest/285829b0-5e4b-11f0-a785-c55a8f5bd3a2', external: true },
  { label: 'Events', href: '/#events' },
  { label: 'Delivery', href: '/#order-section' },
];

const orderApps = [
  { label: 'Drivu (Drive-thru)', href: 'https://drivu.co/DriveThru/Baitna_Cafe_YvEKO/Corniche_Road,_Sharjah' },
  { label: 'Beanz (Delivery)', href: '' }, // add the link when ready
  { label: 'noon (Delivery)', href: 'https://food.noon.com/uae-en/outlet/BTNCF5SGLA/' },
];

const linkClass = 'inline-flex min-h-10 items-center underline-offset-4 hover:underline';
const headingClass = 'mb-5 text-lg tracking-[0.15em] xl:text-2xl';
const buttonClass =
  'inline-flex min-h-12 items-center gap-2 bg-[#7a5c34] px-7 text-sm uppercase tracking-[0.2em] text-cream ' +
  'transition-colors hover:bg-[#5c4426] md:min-h-14 md:px-9 md:text-base xl:min-h-16 xl:px-10 ' +
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7a5c34]';
---

<footer class="bg-[#ecd5b3] text-black">
  <div class="mx-auto w-full max-w-[1920px] px-5 pt-14 pb-8 md:px-10 md:pt-16 xl:px-12 xl:pt-20">

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.1fr_1fr_1fr_1.4fr] lg:gap-0">

      <!-- Hours + call -->
      <div class="lg:pr-10 xl:pr-14">
        <p class={headingClass}>Opening hours</p>
        <dl class="grid w-fit grid-cols-[auto_auto] gap-x-8 gap-y-2 text-base xl:text-xl">
          {hours.map((h) => (
            <>
              <dt>{h.days}</dt>
              <dd>{h.time}</dd>
            </>
          ))}
        </dl>

        <p class="mt-8 mb-5 text-base leading-relaxed xl:text-xl">Questions or bookings?</p>
        <div class="flex flex-wrap gap-3">
          <a href={phoneHref} class={buttonClass}>
            <svg class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z" />
            </svg>
            Call us
          </a>

          <a href={reserveUrl} target="_blank" rel="noopener noreferrer" class={buttonClass}>
            Book now
          </a>
        </div>
      </div>

      <!-- Explore + order -->
      <div class="lg:border-l lg:border-black/40 lg:px-10 xl:px-14">
        <nav aria-label="Footer">
          <p class={headingClass}>Explore</p>
          <ul class="text-base xl:text-xl">
            {pages.map((p) => (
              <li>
                <a
                  href={p.href}
                  class={linkClass}
                  {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <p class={`mt-8 ${headingClass}`}>Order online</p>
        <ul class="text-base xl:text-xl">
          {orderApps.map((a) => (
            <li>
              {a.href ? (
                <a href={a.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  {a.label}
                </a>
              ) : (
                <span class="inline-flex min-h-10 items-center text-black/50">
                  {a.label} · soon
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact + social -->
      <div class="lg:border-l lg:border-black/40 lg:px-10 xl:px-14">
        <p class={headingClass}>Contact</p>
        <ul class="text-base xl:text-xl">
          <li><a href={phoneHref} class={linkClass}>{phone}</a></li>
          <li>
            <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer" class={linkClass}>
              Message us on WhatsApp
            </a>
          </li>
        </ul>

        <p class={`mt-8 ${headingClass}`}>Follow us</p>
        <div class="-ml-2 flex items-center gap-3">
          <a href="https://instagram.com/baitnacafe" target="_blank" rel="noopener noreferrer"
             aria-label="Baitna Café on Instagram"
             class="inline-flex h-12 w-12 items-center justify-center transition hover:opacity-60 motion-reduce:transition-none xl:h-14 xl:w-14">
            <svg class="h-8 w-8 xl:h-9 xl:w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="https://www.tiktok.com/@baitnacafe" target="_blank" rel="noopener noreferrer"
             aria-label="Baitna Café on TikTok"
             class="inline-flex h-12 w-12 items-center justify-center transition hover:opacity-60 motion-reduce:transition-none xl:h-14 xl:w-14">
            <svg class="h-8 w-8 xl:h-9 xl:w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.6 2h-3.3v13.2a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9a6.3 6.3 0 1 0 5.3 6.2V8.6a8 8 0 0 0 4.4 1.3V6.6a4.6 4.6 0 0 1-4.4-4.6Z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Location -->
      <div class="lg:border-l lg:border-black/40 lg:pl-10 xl:pl-14">
        <p class={headingClass}>Location</p>
        <div class="aspect-[16/10] w-full overflow-hidden">
          <iframe
            src={mapEmbedSrc}
            title="Map showing Baitna Café at Tabark Tower, Al Mamzar, Sharjah"
            class="h-full w-full border-0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <a href={mapLink}
           target="_blank" rel="noopener noreferrer"
           class={`mt-3 text-base leading-relaxed xl:text-xl ${linkClass}`}>
          {address}
        </a>
      </div>
    </div>

    <!-- Wordmark -->
    <div class="mx-auto mt-12 max-w-[720px] border-t border-black/40 pt-8 text-center xl:mt-16">
      <p class="text-3xl tracking-[0.35em] md:text-5xl xl:text-6xl">BAITNA CAFE</p>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center gap-2 text-sm text-black/70 sm:flex-row sm:justify-between xl:text-base">
      <p>© {year} Baitna Café. All rights reserved.</p>
      <p>Website by Nour Saneh</p>
    </div>
  </div>
</footer>