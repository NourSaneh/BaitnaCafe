---
import '../styles/global.css';

const title = 'Baitna Cafe | Your home above Sharjah';
const description =
  'Rooftop café on the 30th floor in Al Mamzar, Sharjah. Specialty coffee, fresh bites and skyline views. Open daily 8 am – 2 am.';
const siteUrl = 'https://baitna-cafe-pied.vercel.app';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="icon" href="/favicon.svg" />

    <!-- WhatsApp / Instagram / Facebook preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Rooftop café on the 30th floor. Open daily 8 am – 2 am." />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>