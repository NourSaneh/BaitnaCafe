---
import '../styles/global.css';
import { business as b } from '../data/business';

interface Props {
  title?: string;
  noindex?: boolean; // e.g. the 404 page: keep it out of Google
}

const { title = 'Baitna Cafe | Your home above Sharjah', noindex = false } = Astro.props;
const siteUrl = Astro.site?.href ?? 'https://baitna-cafe-pied.vercel.app/';
const ogImage = new URL('/og-image.jpg', siteUrl).href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={b.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={siteUrl} />}
    <link rel="icon" href="/favicon.svg" />

    <!-- WhatsApp / Instagram / Facebook preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={b.name} />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Rooftop café on the 30th floor. Open daily 8 am – 2 am." />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Baitna Cafe interior overlooking Sharjah" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <slot />
  </body>
</html>
